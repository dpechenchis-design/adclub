.nav button .n{font-family:var(--display);font-size:18px;opacity:.85}
.nav button[aria-pressed="true"]{background:var(--green);border-color:var(--green);color:var(--navy)}
.side .how{font-size:14px;color:#cdd3f2;margin:0}
.side .how b{color:#fff}
.search:focus,.nav button:focus-visible,summary:focus-visible,a:focus-visible,button:focus-visible{outline:3px solid var(--green);outline-offset:2px}
section.block{margin-bottom:30px}
.block h2{font-family:var(--display);font-size:36px;margin:0;font-weight:700;display:flex;align-items:center;gap:12px;flex-wrap:wrap;text-transform:uppercase}
.block h2 .tag{font-size:14px;font-family:var(--body);font-weight:600;color:var(--muted);text-transform:none}
.block .note{color:var(--muted);margin:4px 0 14px;max-width:72ch;font-size:15px}
.bar-accent{display:inline-block;width:12px;height:30px;border-radius:2px}
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fill,minmax(min(100%,420px),1fr))}
.card{background:var(--card);border:1px solid var(--line);border-top:6px solid var(--accent);border-radius:10px;padding:16px;display:flex;flex-direction:column;gap:10px}
.top{display:flex;gap:14px;align-items:flex-start}
.avatar{flex:none;width:72px;height:72px;border-radius:50%;display:grid;place-items:center;font-family:var(--display);font-size:28px;font-weight:700;color:#fff;background:var(--accent);border:3px solid #fff;box-shadow:0 0 0 2px var(--accent);object-fit:cover}
.who h3{margin:0;font-family:var(--display);font-size:25px;line-height:1.05;text-transform:uppercase;letter-spacing:.02em}
.role{margin:3px 0 0;font-weight:700}
.co{margin:0;color:var(--muted);font-size:14px;font-weight:600}
.li{display:inline-flex;align-items:center;gap:6px;margin-top:8px;background:#0a66c2;color:#fff;text-decoration:none;font-weight:700;font-size:13px;padding:5px 10px;border-radius:6px}
.li:hover{background:#004182}
.li svg{width:14px;height:14px;fill:#fff}
.facts-list{margin:0;padding:0;list-style:none;display:grid;gap:6px;font-size:15px}
.facts-list li{display:grid;grid-template-columns:92px 1fr;gap:8px}
.facts-list .k{font-weight:700;color:var(--muted);font-size:13px;text-transform:uppercase;letter-spacing:.04em;padding-top:2px}
.about{margin:0;font-size:15px;background:var(--paper);border-left:3px solid var(--accent);padding:8px 10px;border-radius:0 6px 6px 0}
details{border-top:1px solid var(--line);padding-top:8px}
summary{cursor:pointer;font-weight:700;padding:4px 0}
ol.qs{margin:8px 0 0;padding-left:22px;display:grid;gap:8px}
.pbox{margin-top:8px;display:grid;gap:8px}
.pbox p{margin:0;font-size:14px;color:var(--muted)}
textarea.prompt{width:100%;min-height:230px;background:var(--paper);color:var(--ink);border:1px solid var(--line);border-radius:8px;padding:10px;font:13px/1.45 ui-monospace,Menlo,Consolas,monospace;resize:vertical}
button.btn{background:var(--navy);color:#fff;border:0;border-radius:8px;padding:9px 14px;font:700 14px var(--body);cursor:pointer;justify-self:start}
.empty{padding:30px;text-align:center;color:var(--muted);display:none}
.alsonote{font-size:14px;color:var(--muted);margin:-6px 0 14px}
@media (max-width:860px){.layout{grid-template-columns:1fr}aside.side{position:static}.nav{grid-template-columns:repeat(2,1fr)}}
@media (max-width:520px){.top{flex-direction:column}.facts-list li{grid-template-columns:1fr;gap:0}}
</style>
</head>
