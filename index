.layout{display:grid;grid-template-columns:240px 1fr;gap:28px;align-items:start;padding-top:24px}
aside.side{position:sticky;top:16px;background:var(--navy);color:#fff;border-radius:12px;padding:18px}
.side h2{font-family:var(--display);text-transform:uppercase;letter-spacing:.08em;font-size:15px;color:#d6e88a;margin:0 0 10px}
.search{width:100%;border:0;border-radius:8px;padding:10px 12px;font:inherit;color:var(--navy);margin-bottom:16px}
.nav{display:grid;gap:6px;margin-bottom:18px}
