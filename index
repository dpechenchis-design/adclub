];
var CATS=['Career path and first job','Day-to-day work and skills','Company and team','Breaking in: internships, portfolio, networking','Industry trends and AI','The session topic','Advice and mistakes'];
var LI_ICON='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>';

function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}
function initials(n){var p=n.split(' ');return (p[0][0]+p[p.length-1][0]).toUpperCase()}
function sec(g){for(var i=0;i<SECTIONS.length;i++)if(SECTIONS[i].g===g)return SECTIONS[i]}
function buildPrompt(p){
  var lines=[
'ABOUT ME: [Replace this line: your program and school, year, the role you want, anything you have done so far, and what you want from this conversation.]',
'',
'You are helping me prepare to talk with a speaker at AdClub of Toronto Student Day (November 17, 2026, Dentsu Toronto). I am a marketing and advertising student.',
'',
'PERSON',
'Name: '+p.name,
'Current role: '+p.title+', '+p.co,
'Where I will meet them: '+sec(p.g).session];
  if(p.past)lines.push('Earlier experience: '+p.past);
  if(p.edu)lines.push('Education: '+p.edu);
  if(p.about)lines.push('Background: '+p.about);
  lines=lines.concat(['',
'TASK',
'Write 20 questions I could ask this person, grouped under these headings: '+CATS.join('; ')+'.',
'Base every question on the background above and on what I wrote about myself. Do not invent facts about the person. If a question needs a detail you do not have, phrase it as a question rather than a claim.',
'Keep each question to one or two sentences that sound natural said out loud. Make them open-ended and avoid anything I could answer by reading their LinkedIn.',
'At the end, mark the 3 questions you would ask first in a 2-minute conversation, and add one follow-up question for each.']);
  return lines.join('\n');
}

var state={f:'all',q:''};
function hay(p){return (p.name+' '+p.title+' '+p.co+' '+(p.past||'')+' '+(p.edu||'')+' '+(p.about||'')+' '+p.qs.join(' ')).toLowerCase()}
function renderNav(){
  var nav=document.getElementById('nav');
  var items=[{f:'all',label:'All',n:PEOPLE.length}].concat(SECTIONS.map(function(s){return {f:s.g,label:s.title,n:PEOPLE.filter(function(p){return p.g===s.g}).length}}));
  nav.innerHTML=items.map(function(it){return '<button type="button" data-f="'+it.f+'" aria-pressed="'+(state.f===it.f)+'"><span>'+it.label+'</span><span class="n">'+it.n+'</span></button>'}).join('');
}
function card(p,s){
  var photo=PHOTOS[p.name]?'<img class="avatar" src="'+PHOTOS[p.name]+'" alt="'+esc(p.name)+'">':'<div class="avatar" aria-hidden="true">'+initials(p.name)+'</div>';
  var facts='';
  if(p.past)facts+='<li><span class="k">Before</span><span>'+esc(p.past)+'</span></li>';
  if(p.edu)facts+='<li><span class="k">Studied</span><span>'+esc(p.edu)+'</span></li>';
  var idx=PEOPLE.indexOf(p);
  return '<article class="card" style="--accent:'+s.accent+'">'+
    '<div class="top">'+photo+'<div class="who"><h3>'+esc(p.name)+'</h3><p class="role">'+esc(p.title)+'</p><p class="co">'+esc(p.co)+(p.role?' \u00b7 Committee: '+esc(p.role):'')+'</p>'+
    (p.li?'<a class="li" href="'+esc(p.li)+'" target="_blank" rel="noopener">'+LI_ICON+'View on LinkedIn</a>':'')+'</div></div>'+
    (facts?'<ul class="facts-list">'+facts+'</ul>':'')+
    (p.about?'<p class="about">'+esc(p.about)+'</p>':'')+
    '<details><summary>'+p.qs.length+' questions to ask</summary><ol class="qs">'+p.qs.map(function(x){return '<li>'+esc(x)+'</li>'}).join('')+'</ol></details>'+
    '<details><summary>Prompt for 20 more questions</summary><div class="pbox"><p>Paste into ChatGPT or Claude, then replace the first line with a few words about you.</p><textarea class="prompt" readonly aria-label="Prompt for '+esc(p.name)+'">'+esc(buildPrompt(p))+'</textarea><button class="btn" type="button">Copy prompt</button></div></details>'+
  '</article>';
}
function render(){
  var host=document.getElementById('sections'),html='',any=false;
  SECTIONS.forEach(function(s){
    if(state.f!=='all'&&state.f!==s.g)return;
    var list=PEOPLE.filter(function(p){return p.g===s.g&&(!state.q||hay(p).indexOf(state.q)>-1)});
    if(!list.length)return;any=true;
    html+='<section class="block"><h2><span class="bar-accent" style="background:'+s.accent+'"></span>'+s.title+'<span class="tag">'+s.tag+' · '+list.length+' people</span></h2><p class="note">'+s.note+'</p>'+(s.also&&!state.q?'<p class="alsonote">'+s.also+'</p>':'')+'<div class="grid">'+list.map(function(p){return card(p,s)}).join('')+'</div></section>';
  });
  host.innerHTML=html;
  document.getElementById('empty').style.display=any?'none':'block';
}
document.getElementById('nav').addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;state.f=b.getAttribute('data-f');renderNav();render();window.scrollTo({top:document.querySelector('.layout').offsetTop-8,behavior:'smooth'})});
document.getElementById('q').addEventListener('input',function(e){state.q=e.target.value.trim().toLowerCase();render()});
document.getElementById('sections').addEventListener('click',function(e){
  var b=e.target.closest('button.btn');if(!b)return;
  var ta=b.parentNode.querySelector('textarea');ta.focus();ta.select();
  var done=function(){b.textContent='Copied';setTimeout(function(){b.textContent='Copy prompt'},1500)};
  try{navigator.clipboard.writeText(ta.value).then(done,function(){try{document.execCommand('copy');done()}catch(x){b.textContent='Press Ctrl+C to copy'}})}catch(err){try{document.execCommand('copy');done()}catch(e2){b.textContent='Press Ctrl+C to copy'}}
});
renderNav();render();
